# InterviewIQ Backend Environment Template
# Copy this file to backend/.env and populate with your credentials.

# Database Engine: 'mysql' or 'sqlite'
DB_ENGINE=mysql

# MySQL Settings
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=interviewiq_app
DB_PASSWORD=your_mysql_password
DB_NAME=interviewiq
TEST_DB_NAME=interviewiq_test

# Connection Pool Settings
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=3600

# SQLite Fallback Path
SQLITE_DB_PATH=backend/interviewiq.db

# OpenAI API Configuration (Optional)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Gmail SMTP Configuration for Real Email OTP Verification
# SMTP_HOST: smtp.gmail.com
# SMTP_PORT: 587 (STARTTLS)
# SMTP_USERNAME: your-dedicated-email@gmail.com
# SMTP_PASSWORD: 16-character Google App Password (e.g. abcd efgh ijkl mnop)
# SMTP_FROM: InterviewIQ Security <your-dedicated-email@gmail.com>
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=InterviewIQ <no-reply@interviewiq.io>
